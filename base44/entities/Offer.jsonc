{
  "name": "Offer",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "property_title": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "offer_type": {
      "type": "string",
      "enum": [
        "Cash",
        "Conventional",
        "FHA",
        "Hard Money",
        "Subject-To",
        "Wholesale Assignment"
      ],
      "default": "Cash"
    },
    "earnest_money": {
      "type": "number"
    },
    "closing_timeline_days": {
      "type": "number"
    },
    "contingencies": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Under Review",
        "Counter-Offered",
        "Accepted",
        "Rejected",
        "Withdrawn"
      ],
      "default": "Submitted"
    },
    "investor_name": {
      "type": "string"
    },
    "investor_email": {
      "type": "string"
    },
    "investor_phone": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "property_title",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.portal_role": "agent"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.portal_role": "agent"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}