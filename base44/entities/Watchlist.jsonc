{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "property_title": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "asking_price": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "property_title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}