{
  "name": "Inventory Pipeline",
  "description": "Full end-to-end automation: syncs properties from Supabase, validates availability, and cleans inventory every 2 hours",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": 2,
      "interval_unit": "hours",
      "interval_anchor": "2026-10-05T14:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "inventory_pipeline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_pipeline": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runPipeline",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run inventory pipeline",
            "description": "Sync \u2192 Validate \u2192 Clean"
          }
        }
      }
    ]
  }
}